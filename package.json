{
  "name": "locafy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env database/scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env database/seeds/base.ts",
    "db:seed:demo": "tsx --env-file=.env database/seeds/demo.ts",
    "db:reset": "tsx --env-file=.env database/scripts/reset.ts",
    "db:create-admin": "tsx --env-file=.env database/scripts/create-admin.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "5.14.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.20.0"
}
