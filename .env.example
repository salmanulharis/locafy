# ---------------------------------------------------------------------------
# Locafy environment configuration. Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

# PostgreSQL 15+ with the postgis, pg_trgm, citext and pgcrypto extensions available.
# Local dev: `pnpm db:up` starts a PostGIS container matching this URL.
DATABASE_URL=postgres://locafy:locafy_dev_pw@localhost:54329/locafy
# Used by integration + e2e tests only. Must point at a disposable database.
TEST_DATABASE_URL=postgres://locafy:locafy_dev_pw@localhost:54329/locafy_test
E2E_DATABASE_URL=postgres://locafy:locafy_dev_pw@localhost:54329/locafy_e2e

# Public base URL of the app (used for absolute links and Origin checks).
APP_URL=http://localhost:3000

# Session lifetime in days for web cookies and mobile bearer tokens.
SESSION_TTL_DAYS=30

# Default market. Currency is ISO 4217; prices are stored in minor units.
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_COUNTRY_CODE=in

# ---- Media storage ---------------------------------------------------------
# `local` writes to ./storage/media and serves via /media/*  (dev / single node)
# `supabase` uses Supabase Storage (requires the three SUPABASE_* values below)
STORAGE_DRIVER=local
STORAGE_PUBLIC_HOST=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=locafy-media

# ---- Maps & geocoding ------------------------------------------------------
# MapLibre style URL. OpenFreeMap requires no key. Replace for production SLAs.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Nominatim-compatible geocoder. Leave empty to use only the built-in locality
# table. The public OSM instance requires a contact email and <=1 req/s.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=

# ---- Email (notifications, password reset) ---------------------------------
# `log` prints outgoing mail to the server log (dev). No SMTP provider is wired
# by default; see docs/integrations.md.
MAIL_DRIVER=log

# ---- Payments --------------------------------------------------------------
# Billing is NOT configured in the MVP. Plans and entitlements work; paid plan
# assignment is done by an administrator. See docs/integrations.md.
BILLING_PROVIDER=none
