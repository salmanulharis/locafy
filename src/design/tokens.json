{
  "$description": "Locafy Blue + Slate design tokens. Platform-independent source of truth: the web app mirrors `semantic` as CSS variables in src/app/globals.css (kept in sync by tests/unit/design-tokens.test.ts); native apps should map the same semantic names to their theme systems. See docs/design-system.md.",
  "version": 1,
  "palette": {
    "blue-600": "#2563EB",
    "blue-700": "#1D4ED8",
    "blue-50": "#EFF6FF",
    "navy-900": "#0F172A",
    "slate-700": "#334155",
    "slate-500": "#64748B",
    "slate-50": "#F8FAFC",
    "white": "#FFFFFF",
    "slate-200": "#E2E8F0",
    "amber-500": "#F59E0B",
    "green-700": "#15803D",
    "amber-700": "#B45309",
    "red-700": "#B91C1C",

    "$derived": "Tints/shades of the brand hues above, used only for functional needs (subtle fills, input outlines, decorative icons, status backgrounds, pressed destructive state). Not separate brand colours.",
    "slate-100": "#F1F5F9",
    "slate-300": "#CBD5E1",
    "slate-400": "#94A3B8",
    "green-50": "#F0FDF4",
    "amber-50": "#FFFBEB",
    "red-50": "#FEF2F2",
    "red-800": "#991B1B"
  },
  "semantic": {
    "bg": { "value": "slate-50", "use": "Page background" },
    "surface": { "value": "white", "use": "Cards, forms, dropdowns, modals, panels" },
    "surface-2": { "value": "slate-100", "use": "Subtle fills: hover rows, neutral chips, placeholders. Use body text (fg), not muted, on it" },
    "fg": { "value": "slate-700", "use": "Body text and descriptions" },
    "fg-strong": { "value": "navy-900", "use": "Headings, prices, prominent text" },
    "fg-muted": { "value": "slate-500", "use": "Secondary text, metadata, timestamps (on bg/surface only)" },
    "fg-subtle": { "value": "slate-400", "use": "Decorative icons only — never text or meaningful icons" },
    "border": { "value": "slate-200", "use": "Card outlines, dividers, table separators" },
    "border-strong": { "value": "slate-300", "use": "Form control outlines" },
    "primary": { "value": "blue-600", "use": "Primary buttons, links, active navigation, selected controls" },
    "primary-hover": { "value": "blue-700", "use": "Hover / pressed / active state of primary" },
    "primary-fg": { "value": "white", "use": "Text and icons on primary" },
    "primary-soft": { "value": "blue-50", "use": "Selected navigation, subtle highlights, informational backgrounds" },
    "primary-soft-fg": { "value": "blue-700", "use": "Text and icons on primary-soft" },
    "accent": { "value": "amber-500", "use": "Discount and offer highlights only (sparingly)" },
    "accent-fg": { "value": "navy-900", "use": "Text on solid accent (white fails contrast)" },
    "accent-soft": { "value": "amber-50", "use": "Soft offer background" },
    "accent-soft-fg": { "value": "amber-700", "use": "Offer text on white or accent-soft" },
    "success": { "value": "green-700", "use": "Success, verified, in stock" },
    "success-soft": { "value": "green-50", "use": "Success background" },
    "success-soft-fg": { "value": "green-700", "use": "Text on success-soft" },
    "warning": { "value": "amber-700", "use": "Warnings, low stock, needs attention" },
    "warning-soft": { "value": "amber-50", "use": "Warning background" },
    "warning-soft-fg": { "value": "amber-700", "use": "Text on warning-soft" },
    "danger": { "value": "red-700", "use": "Errors, failed operations, destructive actions" },
    "danger-hover": { "value": "red-800", "use": "Hover / pressed destructive button" },
    "danger-soft": { "value": "red-50", "use": "Error background" },
    "danger-soft-fg": { "value": "red-700", "use": "Text on danger-soft" },
    "info": { "value": "blue-600", "use": "Informational icons" },
    "info-soft": { "value": "blue-50", "use": "Informational backgrounds" },
    "info-soft-fg": { "value": "blue-700", "use": "Text on info-soft" },
    "ring": { "value": "blue-600", "use": "Keyboard focus indicator" }
  }
}
